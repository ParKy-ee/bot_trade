# ===================================================
# AI SWING TRADING BOT CONFIGURATION (XAMPP MYSQL)
# ===================================================

# Web Server Port
PORT=3000

# XAMPP MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_trading_db
DB_USER=root
DB_PASSWORD=

# Market Scan and Strategy Parameters
# Recommended interval: 5 to 15 minutes
SCAN_INTERVAL_MINUTES=5
# US Stock Market Hours: Scan only during Regular Trading Hours (09:30 - 16:00 ET / ~20:30 - 03:00 THA)
STOCK_MARKET_HOURS_ONLY=true
CONFIDENCE_THRESHOLD=0.45
FOREX_CONFIDENCE_THRESHOLD=0.58
FOREX_SHADOW_HARVESTING=true
FOREX_CHALLENGER_ENABLED=true
FOREX_MODEL_VERSION=v1.3.0
FOREX_STRATEGY_VERSION=ver.beta.5.4
FOREX_CHALLENGER_MODEL_VERSION=challenger-v1.1.0
FOREX_CHALLENGER_CONFIDENCE_THRESHOLD=0.52
FOREX_PRIMARY_MODEL_ROLE=champion
FOREX_SHADOW_MODEL_ROLE=challenger
FOREX_DATA_HARVEST_LIVE_MODE=false
FOREX_DATA_HARVEST_CONFIDENCE_THRESHOLD=0.52
FOREX_DATA_HARVEST_MIN_CONFLUENCE_SCORE=55
FOREX_LIVE_PRODUCTION_GUARD=true
FOREX_RANGE_MODEL_ENABLED=true
FOREX_RANGE_LIVE_ENABLED=false
FOREX_RANGE_MODEL_VERSION=range-v1.0.0
FOREX_RANGE_CONFIDENCE_THRESHOLD=0.58
FOREX_RANGE_MIN_SCORE=60
FOREX_RANGE_MIN_TP_MAJOR=8
FOREX_RANGE_MIN_SL_MAJOR=6
FOREX_RANGE_MIN_TP_JPY=16
FOREX_RANGE_MIN_SL_JPY=12
FOREX_CIRCUIT_BREAKER_LOSS_LIMIT=2
FOREX_SESSION_GUARD_ENABLED=true
FOREX_REJECTION_FILTER_ENABLED=true
# Scale the calculated TP target without changing SL. 0.6 = collect 60% of original TP quickly.
FOREX_TP_MULTIPLIER=0.6
FOREX_DYNAMIC_MIN_RR=1.0
FOREX_GATING_MIN_ADX_JPY=24
FOREX_GATING_MIN_ADX_MAJOR=20
FOREX_GATING_MIN_CSM_MAJOR=1.0
FOREX_GATING_MIN_CSM_JPY=1.2
FOREX_OVEREXTENDED_DISTANCE_ATR=2.4
FOREX_OVEREXTENDED_RSI_BUY=78
FOREX_OVEREXTENDED_RSI_SELL=22
FOREX_SIGNAL_COOLDOWN_MINUTES=15
FOREX_CORRELATED_GUARD_ENABLED=true
FOREX_MAX_CORRELATED_EXPOSURE=2
# Isolated scale-in lane; does not change model features or historical data.
FOREX_SCALE_IN_ENABLED=true
FOREX_SCALE_IN_MAX_POSITIONS_PER_SYMBOL=3
FOREX_SCALE_IN_MIN_DISTANCE_ATR=0.35
FOREX_SCALE_IN_COOLDOWN_MINUTES=30
FOREX_SCALE_IN_LOT_MULTIPLIER=0.5
FOREX_REENTRY_ENABLED=false
FOREX_REENTRY_MAX_POSITIONS_PER_SYMBOL=3
FOREX_REENTRY_MIN_CONFIDENCE=0.60
FOREX_BREAKEVEN_TRIGGER_ATR=1.0

# Telegram Notification (Optional)
# If left empty, notifications will be logged to console only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Python Path for AI Model Bridge (Optional, defaults to python in PATH)
PYTHON_PATH=python

# Global sandbox switch: when true, main engines are shadow-only and cannot
# place live MT5 orders. Keep false for the unrestricted data collector.
TRADING_SANDBOX_ENABLED=false

# Freqtrade-to-MT5 bridge. Leave disabled until verified on an XM demo account.
FREQTRADE_MT5_EXECUTION_ENABLED=false
FREQTRADE_MT5_WEBHOOK_TOKEN=
FREQTRADE_MT5_XAUUSD_MAX_LOT=0.01
FREQTRADE_MT5_EURUSD_MAX_LOT=0.01
FREQTRADE_MT5_BTCUSD_MAX_LOT=0.01
